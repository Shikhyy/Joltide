# --- Nexconn (required for live chat) -------------------------------------
# Console → Key Management. The App Key is public (it ships to the browser).
NEXT_PUBLIC_NEXCONN_APP_KEY=
# NEVER commit or expose the secret. Server-only.
NEXCONN_APP_SECRET=
# Data center of your Nexconn app: SG or NA (must match the console + API host)
NEXT_PUBLIC_NEXCONN_AREA=SG
NEXCONN_API_HOST=api.sg-light-api.com

# --- Player identity ---------------------------------------------------
# Signs player keys so nobody can act as another player. In production set a long random
# value and keep it stable (generate one with: openssl rand -base64 32). If unset, it is
# derived from NEXCONN_APP_SECRET.
IDENTITY_SECRET=

# --- AI generator (optional; falls back to a built-in generator) ----------
ANTHROPIC_API_KEY=

# --- Persistence (optional; local JSON file is used in dev) ---------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
